{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "ninja-msvc-release",
      "displayName": "Ninja + MSVC (RELEASE, sccache disabled)",
      "description": "Canonical production build. Ninja drives the build graph (single-graph parallelism beats per-vcxproj /m), sccache is disabled, and /Z7 embeds debug info via CMP0141 (no mspdbsrv.exe serialization). This is the only supported build configuration. Run from a 'x64 Native Tools Command Prompt for VS 2022' so cl.exe is on PATH, or use the VS Code task which calls vcvars64.bat first.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_MAKE_PROGRAM": "C:/Program Files/Microsoft Visual Studio/2022/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe",
        "AIDA_ENABLE_LTCG": "OFF",
        "AIDA_FAST_LINK":   "ON",
        "AIDA_CAMOUFOX_STAGE_REVERSE_MCP_SOURCE": "ON",
        "AIDA_CAMOUFOX_STAGE_SIDECAR_DEPS": "ON",
        "BUILD_AIDA_PLUGIN": "OFF"
      },
      "environment": {
        "SCCACHE_DISABLE": "1"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ninja-msvc-release",
      "configurePreset": "ninja-msvc-release",
      "jobs": 6
    },
    {
      "name": "ninja-msvc-rebuild",
      "configurePreset": "ninja-msvc-release",
      "cleanFirst": true,
      "jobs": 6
    }
  ]
}
